# Copy to .env.local for development and configure the same names in Vercel.
# Generate independent secrets with: openssl rand -base64 32

# Database (service key must remain server-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public application origin, including https:// and without a trailing slash
NEXT_PUBLIC_APP_URL=https://leads.example.com
NEXT_PUBLIC_SITE_URL=https://leads.example.com

# Dashboard and signed links
DASHBOARD_ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-random-32-byte-secret
UNSUBSCRIBE_SECRET=replace-with-a-different-random-32-byte-secret

# Scheduled endpoint authorization
CRON_SECRET=replace-with-a-random-32-byte-secret

# Lead collection and enrichment
APIFY_TOKEN=your-apify-token
APIFY_FALLBACK_TOKEN=your-secondary-apify-token
APIFY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
HUNTER_API_KEY=your-primary-hunter-key
# Optional rotation keys; any HUNTER_API_KEY* variable is discovered automatically
HUNTER_API_KEY_2=your-second-hunter-key
HUNTER_API_KEY_3=your-third-hunter-key
GEMINI_API_KEY=your-gemini-key

# SMTP delivery
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=hello@example.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=hello@example.com
EMAIL_REPLY_TO=your-monitored-reply-inbox@example.com
EMAIL_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
OUTREACH_BATCH_SIZE=5
OUTREACH_DAILY_LIMIT=30

# Gmail reply synchronization (read-only gmail.metadata OAuth scope)
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# Authenticated read-only MCP endpoint
MCP_REQUESTS_PER_MINUTE=60

# Optional Instantly delivery (manual dashboard action only)
INSTANTLY_API_KEY=your-instantly-api-key
INSTANTLY_CAMPAIGN_ID=your-instantly-campaign-id
INSTANTLY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Optional Telegram reply notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
